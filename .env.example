# Glideinbir — environment template (built by Sahil Thakur)
# Copy to .env and adjust. Never commit .env.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
DJANGO_ADMIN_URL=django-admin/
TIME_ZONE=Asia/Kolkata
API_DOCS_ENABLED=True

# --- JWT ---
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- PostgreSQL (docker compose builds DATABASE_URL from these) ---
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_PORT=5432
# Only needed when running Django outside Docker:
# DATABASE_URL=postgres://crm:crm@localhost:5432/crm

# --- Redis / Celery ---
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379/0

# --- CORS / frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Email (console backend prints e-mails to the backend/celery logs) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Glideinbir <no-reply@glideinbir.local>

# --- Throttling ---
THROTTLE_ANON=60/min
THROTTLE_USER=300/min
THROTTLE_AUTH=10/min
THROTTLE_PAYMENTS=20/min
THROTTLE_SEARCH=60/min

# --- Integrations (mocked in development; point at real providers in production) ---
PAYMENT_PROVIDER=apps.payments.providers.MockPaymentProvider
NOTIFY_EMAIL_PROVIDER=apps.notifications.providers.EmailProvider
NOTIFY_SMS_PROVIDER=apps.notifications.providers.MockSMSProvider
NOTIFY_WHATSAPP_PROVIDER=apps.notifications.providers.MockWhatsAppProvider
# Run Celery tasks inline (only for quick local runs without Redis):
# CELERY_TASK_ALWAYS_EAGER=True

# --- Storage (production: S3-compatible) ---
USE_S3_STORAGE=False
# S3_BUCKET_NAME=
# S3_ENDPOINT_URL=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Production only (docker-compose.prod.yml) ---
# DJANGO_SETTINGS_MODULE=config.settings.prod
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=crm.example.com
# TRUST_X_FORWARDED_FOR=True
# SECURE_SSL_REDIRECT=True
# GUNICORN_WORKERS=3
# CELERY_CONCURRENCY=2
# WEB_PORT=80

# --- Ports ---
BACKEND_PORT=8000
FRONTEND_PORT=5173
